#!/bin/bash
# Run the Claude Code CLI with Kimi K3.1 Pro (Moonshot, via OpenRouter's Anthropic endpoint)
# as every model role. Bead fk2b.
#
# Usage: kimi [claude args...]     e.g. `kimi`, `kimi -c`, `kimi -p "task" --output-format json`
#   Shares the default ~/.claude (settings, plugins, hooks, memory, mailbox), so the session is
#   a peer of the Claude sessions on this machine. The OpenRouter token takes precedence over
#   the claude.ai login, so claude.ai connectors are off in this session (Claude Code warns).
#   Adds --channels plugin:conexus@nexus-plugins and a kimi_<dir>_<hex> name, as the claude
#   shell function does; pass your own --channels or -n to override.
# Env: KIMI_MODEL (default moonshotai/kimi-k3.1-pro), KIMI_CONTEXT_1M (default 1; 0 drops the
#      [1m] suffix and Claude Code assumes 200K), OPENROUTER_API_KEY (else Keychain item
#      kimi-openrouter, else ds-openrouter), CLAUDE_BIN (default: claude on PATH).
# A key of its own (kimi-openrouter) keeps a heavy Kimi session from spending the limit that
# dsh and the supervisor's OpenRouter backends share on ds-openrouter.
# The token is in the claude process's environment as ANTHROPIC_AUTH_TOKEN.
# Claude Code's reported cost is a guess for non-Claude models; OpenRouter's dashboard has the
# real figure.
MODEL=${KIMI_MODEL:-moonshotai/kimi-k3.1-pro}
MAIN=$MODEL
[ "${KIMI_CONTEXT_1M:-1}" = 1 ] && MAIN="$MODEL[1m]"
KEY=${OPENROUTER_API_KEY:-$(security find-generic-password -s kimi-openrouter -w 2>/dev/null)}
KEY=${KEY:-$(security find-generic-password -s ds-openrouter -w 2>/dev/null)}
[ -n "$KEY" ] || { echo "kimi: no OPENROUTER_API_KEY and no Keychain item kimi-openrouter or ds-openrouter" >&2; exit 1; }
CLAUDE=${CLAUDE_BIN:-$(command -v claude)} || { echo "kimi: claude not on PATH" >&2; exit 1; }

# Same session conventions as the interactive `claude` shell function: conexus channels for
# peer messages, and a name with no hyphen (a hyphenated name reads as a bead id to the close
# gates, nexus-rsqdl). Explicit names and print runs keep their own.
PRE=()
case " $* " in *" --channels "*|*" --channels="*) ;; *) PRE=(--channels plugin:conexus@nexus-plugins) ;; esac
case " $* " in
  *" -n "*|*" --name "*|*" --name="*|*" -p "*|*" --print "*) ;;
  *) D=$(basename "$PWD"); PRE+=(-n "kimi_${D//-/_}_$(openssl rand -hex 2 | cut -c1-3)") ;;
esac

export ANTHROPIC_BASE_URL=https://openrouter.ai/api
export ANTHROPIC_AUTH_TOKEN=$KEY
export ANTHROPIC_API_KEY=""
export ANTHROPIC_MODEL=$MAIN
export ANTHROPIC_DEFAULT_FABLE_MODEL=$MAIN
export ANTHROPIC_DEFAULT_OPUS_MODEL=$MAIN
export ANTHROPIC_DEFAULT_SONNET_MODEL=$MAIN
export ANTHROPIC_DEFAULT_HAIKU_MODEL=$MODEL
export CLAUDE_CODE_SUBAGENT_MODEL=$MODEL
unset OPENROUTER_API_KEY
exec "$CLAUDE" "${PRE[@]}" "$@"
